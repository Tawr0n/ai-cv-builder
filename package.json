{
  "name": "ai-cv-builder",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "volta": {
    "node": "24.18.0"
  },
  "scripts": {
    "postinstall": "pnpm --filter @ai-cv-builder/shared build && pnpm --filter @ai-cv-builder/api prisma:generate",
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint --type-aware && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "smoke:live": "pnpm --filter @ai-cv-builder/api smoke:live"
  },
  "devDependencies": {
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  }
}

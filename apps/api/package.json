{
  "name": "@ai-cv-builder/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ],
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "prisma migrate deploy && node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "smoke:live": "tsc -p tsconfig.smoke.json && node --env-file-if-exists=../../.env dist-smoke/smoke/live.js"
  },
  "dependencies": {
    "@ai-cv-builder/cv-template": "workspace:*",
    "@ai-cv-builder/shared": "workspace:*",
    "@anthropic-ai/sdk": "^1.3.0",

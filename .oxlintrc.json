{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "react",
    "nextjs",
    "vitest"
  ],
  "env": {
    "node": true,
    "browser": true
  },
  "rules": {
    "typescript/no-floating-promises": "error",
    "typescript/no-explicit-any": "error"
  },
  "ignorePatterns": [
    "**/generated/**",
    "**/dist/**",
    "**/dist-smoke/**",
    "**/.next/**",
    "**/next-env.d.ts"
  ]
}
